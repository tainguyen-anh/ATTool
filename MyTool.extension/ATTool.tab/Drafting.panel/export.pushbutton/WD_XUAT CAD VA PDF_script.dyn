{
  "Uuid": "a3f976cd-88b4-4f5c-be05-ac25535c5d68",
  "IsCustomNode": false,
  "Description": "Done",
  "Name": "WD_IN BAN VE - Copy",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nimport os\r\nimport json\r\n\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\nclr.AddReference('System.Windows.Forms')\r\nclr.AddReference('System.Drawing')\r\nimport System\r\nfrom System.Windows.Forms import *\r\nfrom System.Drawing import *\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# Quản lý cấu hình lưu trữ\r\nCONFIG_PATH = os.path.join(os.environ.get('TEMP', 'C:\\\\Temp'), 'multi_exporter_config.json')\r\n\r\ndef load_config():\r\n    default_config = {\r\n        \"cad_prefix\": \"DUAN\",\r\n        \"pdf_name\": \"BAN_VE_PDF\",\r\n        \"cad_path\": \"C:\\\\ExportCAD\",\r\n        \"pdf_path\": \"C:\\\\ExportPDF\",\r\n        \"export_cad\": True,\r\n        \"export_pdf\": True,\r\n        \"combine_pdf\": True\r\n    }\r\n    if os.path.exists(CONFIG_PATH):\r\n        try:\r\n            with open(CONFIG_PATH, 'r') as f:\r\n                data = json.load(f)\r\n                default_config.update(data)\r\n        except:\r\n            pass\r\n    return default_config\r\n\r\ndef save_config(cad_prefix, pdf_name, cad_path, pdf_path, cad, pdf, combine):\r\n    try:\r\n        with open(CONFIG_PATH, 'w') as f:\r\n            json.dump({\r\n                \"cad_prefix\": cad_prefix,\r\n                \"pdf_name\": pdf_name,\r\n                \"cad_path\": cad_path,\r\n                \"pdf_path\": pdf_path,\r\n                \"export_cad\": cad,\r\n                \"export_pdf\": pdf,\r\n                \"combine_pdf\": combine\r\n            }, f)\r\n    except:\r\n        pass\r\n\r\n# 1. Thu thập dữ liệu từ Revit project\r\ntry:\r\n    collections = FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_SheetCollections).WhereElementIsNotElementType().ToElements()\r\n    col_dict = {c.Name: c for c in collections} if collections else {}\r\nexcept:\r\n    col_dict = {}\r\n\r\nsheet_sets = FilteredElementCollector(doc).OfClass(ViewSheetSet).ToElements()\r\nset_dict = {s.Name: s for s in sheet_sets} if sheet_sets else {}\r\n\r\ndwg_setups = FilteredElementCollector(doc).OfClass(ExportDWGSettings).ToElements()\r\ndwg_setup_dict = {s.Name: s for s in dwg_setups} if dwg_setups else {}\r\n\r\ntry:\r\n    pdf_setups = FilteredElementCollector(doc).OfClass(ExportPDFSettings).ToElements()\r\n    pdf_setup_dict = {s.Name: s for s in pdf_setups} if pdf_setups else {}\r\nexcept:\r\n    pdf_setup_dict = {}\r\n\r\n# 2. Xây dựng Form UI\r\nclass CustomExportForm(Form):\r\n    def __init__(self):\r\n        saved_config = load_config()\r\n\r\n        self.Text = \"Sheet Collection & Sets (CAD & PDF)\"\r\n        self.ClientSize = Size(660, 660) # Mở rộng tổng chiều rộng Form\r\n        self.StartPosition = FormStartPosition.CenterScreen\r\n        self.FormBorderStyle = FormBorderStyle.FixedDialog\r\n        self.MaximizeBox = False\r\n        self.MinimizeBox = False\r\n        self.AutoScaleMode = AutoScaleMode.Dpi\r\n        self.Font = Font(\"Segoe UI\", 9.5)\r\n\r\n        # 1. Chế độ lọc bản vẽ\r\n        lbl_mode = Label()\r\n        lbl_mode.Text = \"Chế độ lọc bản vẽ:\"\r\n        lbl_mode.Location = Point(20, 20)\r\n        lbl_mode.Size = Size(130, 22)\r\n\r\n        self.rb_col = RadioButton()\r\n        self.rb_col.Text = \"Sheet Collection\"\r\n        self.rb_col.Location = Point(155, 18)\r\n        self.rb_col.Size = Size(150, 24)\r\n        self.rb_col.Checked = True\r\n        self.rb_col.CheckedChanged += self.toggle_mode\r\n\r\n        self.rb_set = RadioButton()\r\n        self.rb_set.Text = \"Sheet Set\"\r\n        self.rb_set.Location = Point(315, 18)\r\n        self.rb_set.Size = Size(120, 24)\r\n\r\n        # 2. Chọn Định Dạng Xuất (Căn chỉnh khoảng cách rộng rãi)\r\n        lbl_fmt = Label()\r\n        lbl_fmt.Text = \"Định dạng xuất:\"\r\n        lbl_fmt.Location = Point(20, 55)\r\n        lbl_fmt.Size = Size(120, 22)\r\n\r\n        self.chk_cad = CheckBox()\r\n        self.chk_cad.Text = \"Xuất CAD (.dwg)\"\r\n        self.chk_cad.Location = Point(155, 53)\r\n        self.chk_cad.Size = Size(145, 24)\r\n        self.chk_cad.Checked = saved_config.get(\"export_cad\", True)\r\n\r\n        self.chk_pdf = CheckBox()\r\n        self.chk_pdf.Text = \"Xuất PDF (.pdf)\"\r\n        self.chk_pdf.Location = Point(305, 53)\r\n        self.chk_pdf.Size = Size(140, 24)\r\n        self.chk_pdf.Checked = saved_config.get(\"export_pdf\", True)\r\n\r\n        self.chk_combine = CheckBox()\r\n        self.chk_combine.Text = \"Gộp chung 1 file PDF\"\r\n        self.chk_combine.Location = Point(450, 53)\r\n        self.chk_combine.Size = Size(190, 24)\r\n        self.chk_combine.Checked = saved_config.get(\"combine_pdf\", True)\r\n\r\n        # 3. Chọn Collection / Set\r\n        self.lbl_target = Label()\r\n        self.lbl_target.Text = \"1. Chọn Sheet Collection:\"\r\n        self.lbl_target.Location = Point(20, 95)\r\n        self.lbl_target.Size = Size(620, 20)\r\n\r\n        self.cb_target = ComboBox()\r\n        self.cb_target.Location = Point(20, 120)\r\n        self.cb_target.Size = Size(620, 25)\r\n        self.cb_target.DropDownStyle = ComboBoxStyle.DropDownList\r\n\r\n        # 4. Tách DWG Setup & PDF Setup\r\n        lbl_dwg_setup = Label()\r\n        lbl_dwg_setup.Text = \"2. Chọn DWG Export Setup:\"\r\n        lbl_dwg_setup.Location = Point(20, 160)\r\n        lbl_dwg_setup.Size = Size(300, 20)\r\n\r\n        self.cb_dwg_setup = ComboBox()\r\n        self.cb_dwg_setup.Location = Point(20, 185)\r\n        self.cb_dwg_setup.Size = Size(300, 25)\r\n        self.cb_dwg_setup.DropDownStyle = ComboBoxStyle.DropDownList\r\n        for k in dwg_setup_dict.keys(): \r\n            self.cb_dwg_setup.Items.Add(k)\r\n        if dwg_setup_dict: \r\n            self.cb_dwg_setup.SelectedIndex = 0\r\n\r\n        lbl_pdf_setup = Label()\r\n        lbl_pdf_setup.Text = \"3. Chọn PDF Export Setup:\"\r\n        lbl_pdf_setup.Location = Point(340, 160)\r\n        lbl_pdf_setup.Size = Size(300, 20)\r\n\r\n        self.cb_pdf_setup = ComboBox()\r\n        self.cb_pdf_setup.Location = Point(340, 185)\r\n        self.cb_pdf_setup.Size = Size(300, 25)\r\n        self.cb_pdf_setup.DropDownStyle = ComboBoxStyle.DropDownList\r\n        self.cb_pdf_setup.Items.Add(\"<in-session>\")\r\n        for k in pdf_setup_dict.keys(): \r\n            self.cb_pdf_setup.Items.Add(k)\r\n        self.cb_pdf_setup.SelectedIndex = 0\r\n\r\n        # 5. Tên / Tiền tố riêng cho CAD & PDF\r\n        lbl_cad_prefix = Label()\r\n        lbl_cad_prefix.Text = \"4. Tiền tố file CAD (<Tự điền>-SheetNumber-SheetName):\"\r\n        lbl_cad_prefix.Location = Point(20, 230)\r\n        lbl_cad_prefix.Size = Size(620, 20)\r\n\r\n        self.txt_cad_prefix = TextBox()\r\n        self.txt_cad_prefix.Location = Point(20, 255)\r\n        self.txt_cad_prefix.Size = Size(620, 25)\r\n        self.txt_cad_prefix.Text = saved_config.get(\"cad_prefix\", \"DUAN\")\r\n\r\n        lbl_pdf_name = Label()\r\n        lbl_pdf_name.Text = \"5. Tên file PDF (Tên file gộp HOẶC Tiền tố khi tách trang):\"\r\n        lbl_pdf_name.Location = Point(20, 295)\r\n        lbl_pdf_name.Size = Size(620, 20)\r\n\r\n        self.txt_pdf_name = TextBox()\r\n        self.txt_pdf_name.Location = Point(20, 320)\r\n        self.txt_pdf_name.Size = Size(620, 25)\r\n        self.txt_pdf_name.Text = saved_config.get(\"pdf_name\", \"TSG-WON\")\r\n\r\n        # 6. Thư mục lưu CAD\r\n        lbl_cad_path = Label()\r\n        lbl_cad_path.Text = \"6. Thư mục lưu file CAD:\"\r\n        lbl_cad_path.Location = Point(20, 360)\r\n        lbl_cad_path.Size = Size(620, 20)\r\n\r\n        self.txt_cad_path = TextBox()\r\n        self.txt_cad_path.Location = Point(20, 385)\r\n        self.txt_cad_path.Size = Size(500, 25)\r\n        self.txt_cad_path.Text = saved_config.get(\"cad_path\", \"C:\\\\ExportCAD\")\r\n\r\n        btn_browse_cad = Button()\r\n        btn_browse_cad.Text = \"Browse...\"\r\n        btn_browse_cad.Location = Point(535, 384)\r\n        btn_browse_cad.Size = Size(105, 27)\r\n        btn_browse_cad.Click += self.browse_cad_folder\r\n\r\n        # 7. Thư mục lưu PDF\r\n        lbl_pdf_path = Label()\r\n        lbl_pdf_path.Text = \"7. Thư mục lưu file PDF:\"\r\n        lbl_pdf_path.Location = Point(20, 425)\r\n        lbl_pdf_path.Size = Size(620, 20)\r\n\r\n        self.txt_pdf_path = TextBox()\r\n        self.txt_pdf_path.Location = Point(20, 450)\r\n        self.txt_pdf_path.Size = Size(500, 25)\r\n        self.txt_pdf_path.Text = saved_config.get(\"pdf_path\", \"C:\\\\ExportPDF\")\r\n\r\n        btn_browse_pdf = Button()\r\n        btn_browse_pdf.Text = \"Browse...\"\r\n        btn_browse_pdf.Location = Point(535, 449)\r\n        btn_browse_pdf.Size = Size(105, 27)\r\n        btn_browse_pdf.Click += self.browse_pdf_folder\r\n\r\n        # Nút Export\r\n        btn_run = Button()\r\n        btn_run.Text = \"XUẤT BẢN VẼ (EXPORT)\"\r\n        btn_run.Location = Point(220, 535)\r\n        btn_run.Size = Size(220, 45)\r\n        btn_run.DialogResult = DialogResult.OK\r\n        btn_run.BackColor = Color.LightSkyBlue\r\n\r\n        # 8. Dòng Bản quyền\r\n        lbl_author = Label()\r\n        lbl_author.Text = \"By: Nguyen Anh Tai\"\r\n        lbl_author.Font = Font(\"Segoe UI\", 8.5, FontStyle.Italic)\r\n        lbl_author.ForeColor = Color.DimGray\r\n        lbl_author.Location = Point(500, 630)\r\n        lbl_author.Size = Size(140, 20)\r\n        lbl_author.TextAlign = ContentAlignment.MiddleRight\r\n\r\n        # Controls Addition\r\n        self.Controls.Add(lbl_mode)\r\n        self.Controls.Add(self.rb_col)\r\n        self.Controls.Add(self.rb_set)\r\n        self.Controls.Add(lbl_fmt)\r\n        self.Controls.Add(self.chk_cad)\r\n        self.Controls.Add(self.chk_pdf)\r\n        self.Controls.Add(self.chk_combine)\r\n        self.Controls.Add(self.lbl_target)\r\n        self.Controls.Add(self.cb_target)\r\n        self.Controls.Add(lbl_dwg_setup)\r\n        self.Controls.Add(self.cb_dwg_setup)\r\n        self.Controls.Add(lbl_pdf_setup)\r\n        self.Controls.Add(self.cb_pdf_setup)\r\n        self.Controls.Add(lbl_cad_prefix)\r\n        self.Controls.Add(self.txt_cad_prefix)\r\n        self.Controls.Add(lbl_pdf_name)\r\n        self.Controls.Add(self.txt_pdf_name)\r\n        self.Controls.Add(lbl_cad_path)\r\n        self.Controls.Add(self.txt_cad_path)\r\n        self.Controls.Add(btn_browse_cad)\r\n        self.Controls.Add(lbl_pdf_path)\r\n        self.Controls.Add(self.txt_pdf_path)\r\n        self.Controls.Add(btn_browse_pdf)\r\n        self.Controls.Add(btn_run)\r\n        self.Controls.Add(lbl_author)\r\n\r\n        self.update_target_list()\r\n\r\n    def toggle_mode(self, sender, args):\r\n        self.update_target_list()\r\n\r\n    def update_target_list(self):\r\n        self.cb_target.Items.Clear()\r\n        if self.rb_col.Checked:\r\n            self.lbl_target.Text = \"1. Chọn Sheet Collection:\"\r\n            for k in col_dict.keys(): \r\n                self.cb_target.Items.Add(k)\r\n            if col_dict: \r\n                self.cb_target.SelectedIndex = 0\r\n        else:\r\n            self.lbl_target.Text = \"1. Chọn Sheet Set sẵn có:\"\r\n            for k in set_dict.keys(): \r\n                self.cb_target.Items.Add(k)\r\n            if set_dict: \r\n                self.cb_target.SelectedIndex = 0\r\n\r\n    def browse_cad_folder(self, sender, args):\r\n        dialog = FolderBrowserDialog()\r\n        if dialog.ShowDialog() == DialogResult.OK:\r\n            self.txt_cad_path.Text = dialog.SelectedPath\r\n\r\n    def browse_pdf_folder(self, sender, args):\r\n        dialog = FolderBrowserDialog()\r\n        if dialog.ShowDialog() == DialogResult.OK:\r\n            self.txt_pdf_path.Text = dialog.SelectedPath\r\n\r\n# 3. Hiển thị Form và Xử lý Xuất file\r\nApplication.EnableVisualStyles()\r\nform = CustomExportForm()\r\n\r\nif form.ShowDialog() == DialogResult.OK:\r\n    selected_target_name = form.cb_target.SelectedItem\r\n    selected_dwg_setup_name = form.cb_dwg_setup.SelectedItem\r\n    selected_pdf_setup_name = form.cb_pdf_setup.SelectedItem\r\n    \r\n    cad_prefix = form.txt_cad_prefix.Text\r\n    pdf_name = form.txt_pdf_name.Text\r\n    cad_folder_path = form.txt_cad_path.Text\r\n    pdf_folder_path = form.txt_pdf_path.Text\r\n    \r\n    export_cad = form.chk_cad.Checked\r\n    export_pdf = form.chk_pdf.Checked\r\n    combine_pdf = form.chk_combine.Checked\r\n\r\n    save_config(cad_prefix, pdf_name, cad_folder_path, pdf_folder_path, export_cad, export_pdf, combine_pdf)\r\n\r\n    # Lọc danh sách Sheets\r\n    matched_sheets = []\r\n    if form.rb_col.Checked:\r\n        target_col = col_dict.get(selected_target_name)\r\n        if target_col:\r\n            all_sheets = FilteredElementCollector(doc).OfClass(ViewSheet).ToElements()\r\n            for s in all_sheets:\r\n                p = s.get_Parameter(BuiltInParameter.SHEET_COLLECTION)\r\n                if not p:\r\n                    p = s.LookupParameter(\"Sheet Collection\")\r\n                if p and p.AsElementId() == target_col.Id:\r\n                    matched_sheets.append(s)\r\n    else:\r\n        target_set = set_dict.get(selected_target_name)\r\n        if target_set:\r\n            for v in target_set.Views:\r\n                if isinstance(v, ViewSheet):\r\n                    matched_sheets.append(v)\r\n\r\n    # Thiết lập CAD Options\r\n    selected_dwg_setup = dwg_setup_dict.get(selected_dwg_setup_name)\r\n    dwg_options = selected_dwg_setup.GetDWGExportOptions() if selected_dwg_setup else DWGExportOptions()\r\n    dwg_options.MergedViews = True\r\n\r\n    cad_count = 0\r\n    pdf_count = 0\r\n\r\n    TransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\n    # 1. XỬ LÝ XUẤT CAD\r\n    if export_cad and matched_sheets:\r\n        if not os.path.exists(cad_folder_path):\r\n            os.makedirs(cad_folder_path)\r\n            \r\n        for sheet in matched_sheets:\r\n            sheet_ids = System.Collections.Generic.List[ElementId]([sheet.Id])\r\n            s_num = str(sheet.SheetNumber).replace(\"/\", \"-\").replace(\"\\\\\", \"-\")\r\n            s_name = str(sheet.Name).replace(\"/\", \"-\").replace(\"\\\\\", \"-\")\r\n            custom_filename = \"{}-{}-{}\".format(cad_prefix, s_num, s_name)\r\n\r\n            if doc.Export(cad_folder_path, custom_filename, sheet_ids, dwg_options):\r\n                cad_count += 1\r\n\r\n    # 2. XỬ LÝ XUẤT PDF\r\n    if export_pdf and matched_sheets:\r\n        if not os.path.exists(pdf_folder_path):\r\n            os.makedirs(pdf_folder_path)\r\n            \r\n        try:\r\n            pdf_options = PDFExportOptions()\r\n            pdf_options.Combine = combine_pdf\r\n            \r\n            selected_pdf_setup = pdf_setup_dict.get(selected_pdf_setup_name)\r\n            if selected_pdf_setup:\r\n                pdf_options = selected_pdf_setup.GetPDFExportOptions()\r\n                pdf_options.Combine = combine_pdf\r\n\r\n            if combine_pdf:\r\n                pdf_options.FileName = pdf_name\r\n                sheet_ids = System.Collections.Generic.List[ElementId]([s.Id for s in matched_sheets])\r\n                doc.Export(pdf_folder_path, sheet_ids, pdf_options)\r\n                pdf_count = len(matched_sheets)\r\n            else:\r\n                for sheet in matched_sheets:\r\n                    sheet_ids = System.Collections.Generic.List[ElementId]([sheet.Id])\r\n                    s_num = str(sheet.SheetNumber).replace(\"/\", \"-\").replace(\"\\\\\", \"-\")\r\n                    s_name = str(sheet.Name).replace(\"/\", \"-\").replace(\"\\\\\", \"-\")\r\n                    \r\n                    pdf_options.FileName = \"{}-{}-{}\".format(pdf_name, s_num, s_name)\r\n                    doc.Export(pdf_folder_path, sheet_ids, pdf_options)\r\n                    pdf_count += 1\r\n        except Exception as e:\r\n            pass\r\n\r\n    TransactionManager.Instance.TransactionTaskDone()\r\n    OUT = \"Hoàn tất! Đã xuất: {} file CAD và {} trang PDF.\".format(cad_count, pdf_count)\r\nelse:\r\n    OUT = \"Đã hủy thao tác.\"",
