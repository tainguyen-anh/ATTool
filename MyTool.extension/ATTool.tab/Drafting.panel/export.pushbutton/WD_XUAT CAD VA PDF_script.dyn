{
  "Uuid": "a3f976cd-88b4-4f5c-be05-ac25535c5d68",
  "IsCustomNode": false,
  "Description": "Done",
  "Name": "WD_XUAT CAD VA PDF_script",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import sys\r\nimport os\r\nimport json\r\nimport clr\r\n\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\nclr.AddReference('System.Windows.Forms')\r\nclr.AddReference('System.Drawing')\r\nimport System\r\nfrom System.Windows.Forms import (\r\n    Form, Label, TextBox, Button, ComboBox, CheckBox, RadioButton,\r\n    DialogResult, FormStartPosition, FormBorderStyle, ComboBoxStyle\r\n)\r\nfrom System.Drawing import Size, Point, Font, FontStyle, Color\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# Quản lý cấu hình\r\nCONFIG_PATH = os.path.join(os.environ.get('TEMP', 'C:\\\\Temp'), 'multi_exporter_config.json')\r\n\r\ndef load_config():\r\n    cfg = {\r\n        \"cad_prefix\": \"DUAN\", \"pdf_name\": \"BAN_VE_PDF\",\r\n        \"cad_path\": \"C:\\\\ExportCAD\", \"pdf_path\": \"C:\\\\ExportPDF\",\r\n        \"export_cad\": True, \"export_pdf\": True, \"combine_pdf\": True\r\n    }\r\n    if os.path.exists(CONFIG_PATH):\r\n        try:\r\n            with open(CONFIG_PATH, 'r') as f:\r\n                cfg.update(json.load(f))\r\n        except: pass\r\n    return cfg\r\n\r\ndef save_config(cad_p, pdf_n, cad_path, pdf_path, cad, pdf, comb):\r\n    try:\r\n        with open(CONFIG_PATH, 'w') as f:\r\n            json.dump({\r\n                \"cad_prefix\": cad_p, \"pdf_name\": pdf_n,\r\n                \"cad_path\": cad_path, \"pdf_path\": pdf_path,\r\n                \"export_cad\": cad, \"export_pdf\": pdf, \"combine_pdf\": comb\r\n            }, f)\r\n    except: pass\r\n\r\n# Lấy dữ liệu Revit\r\ntry:\r\n    collections = FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_SheetCollections).WhereElementIsNotElementType().ToElements()\r\n    col_dict = {c.Name: c for c in collections} if collections else {}\r\nexcept: col_dict = {}\r\n\r\nsheet_sets = FilteredElementCollector(doc).OfClass(ViewSheetSet).ToElements()\r\nset_dict = {s.Name: s for s in sheet_sets} if sheet_sets else {}\r\n\r\ndwg_setups = FilteredElementCollector(doc).OfClass(ExportDWGSettings).ToElements()\r\ndwg_setup_dict = {s.Name: s for s in dwg_setups} if dwg_setups else {}\r\n\r\ntry:\r\n    pdf_setups = FilteredElementCollector(doc).OfClass(ExportPDFSettings).ToElements()\r\n    pdf_setup_dict = {s.Name: s for s in pdf_setups} if pdf_setups else {}\r\nexcept: pdf_setup_dict = {}\r\n\r\n# Khởi tạo Form UI\r\nsaved_cfg = load_config()\r\nform = Form()\r\nform.Text = \"Sheet Collection & Sets (CAD & PDF)\"\r\nform.Size = Size(680, 680)\r\nform.StartPosition = FormStartPosition.CenterScreen\r\nform.FormBorderStyle = FormBorderStyle.FixedDialog\r\nform.MaximizeBox = False\r\nform.MinimizeBox = False\r\n\r\n# Hàm tạo nhanh Control tránh lỗi render\r\ndef create_label(text, x, y, w, h):\r\n    lbl = Label()\r\n    lbl.Text = text\r\n    lbl.Location = Point(x, y)\r\n    lbl.Size = Size(w, h)\r\n    return lbl\r\n\r\n# 1. Chế độ lọc\r\nform.Controls.Add(create_label(\"Chế độ lọc bản vẽ:\", 20, 20, 130, 22))\r\n\r\nrb_col = RadioButton()\r\nrb_col.Text = \"Sheet Collection\"\r\nrb_col.Location = Point(155, 18)\r\nrb_col.Size = Size(150, 24)\r\nrb_col.Checked = True\r\nform.Controls.Add(rb_col)\r\n\r\nrb_set = RadioButton()\r\nrb_set.Text = \"Sheet Set\"\r\nrb_set.Location = Point(315, 18)\r\nrb_set.Size = Size(120, 24)\r\nform.Controls.Add(rb_set)\r\n\r\n# 2. Định dạng\r\nform.Controls.Add(create_label(\"Định dạng xuất:\", 20, 55, 120, 22))\r\n\r\nchk_cad = CheckBox()\r\nchk_cad.Text = \"Xuất CAD (.dwg)\"\r\nchk_cad.Location = Point(155, 53)\r\nchk_cad.Size = Size(145, 24)\r\nchk_cad.Checked = saved_cfg.get(\"export_cad\", True)\r\nform.Controls.Add(chk_cad)\r\n\r\nchk_pdf = CheckBox()\r\nchk_pdf.Text = \"Xuất PDF (.pdf)\"\r\nchk_pdf.Location = Point(305, 53)\r\nchk_pdf.Size = Size(140, 24)\r\nchk_pdf.Checked = saved_cfg.get(\"export_pdf\", True)\r\nform.Controls.Add(chk_pdf)\r\n\r\nchk_combine = CheckBox()\r\nchk_combine.Text = \"Gộp chung 1 file PDF\"\r\nchk_combine.Location = Point(450, 53)\r\nchk_combine.Size = Size(190, 24)\r\nchk_combine.Checked = saved_cfg.get(\"combine_pdf\", True)\r\nform.Controls.Add(chk_combine)\r\n\r\n# 3. Target List\r\nform.Controls.Add(create_label(\"1. Danh sách Sheet Collection / Set sẵn có:\", 20, 95, 620, 20))\r\ncb_target = ComboBox()\r\ncb_target.Location = Point(20, 120)\r\ncb_target.Size = Size(620, 25)\r\ncb_target.DropDownStyle = ComboBoxStyle.DropDownList\r\nfor k in list(col_dict.keys()) + list(set_dict.keys()):\r\n    cb_target.Items.Add(k)\r\nif cb_target.Items.Count > 0: cb_target.SelectedIndex = 0\r\nform.Controls.Add(cb_target)\r\n\r\n# 4. Setup\r\nform.Controls.Add(create_label(\"2. Chọn DWG Export Setup:\", 20, 160, 300, 20))\r\ncb_dwg = ComboBox()\r\ncb_dwg.Location = Point(20, 185)\r\ncb_dwg.Size = Size(300, 25)\r\ncb_dwg.DropDownStyle = ComboBoxStyle.DropDownList\r\nfor k in dwg_setup_dict.keys(): cb_dwg.Items.Add(k)\r\nif dwg_setup_dict: cb_dwg.SelectedIndex = 0\r\nform.Controls.Add(cb_dwg)\r\n\r\nform.Controls.Add(create_label(\"3. Chọn PDF Export Setup:\", 340, 160, 300, 20))\r\ncb_pdf = ComboBox()\r\ncb_pdf.Location = Point(340, 185)\r\ncb_pdf.Size = Size(300, 25)\r\ncb_pdf.DropDownStyle = ComboBoxStyle.DropDownList\r\ncb_pdf.Items.Add(\"<in-session>\")\r\nfor k in pdf_setup_dict.keys(): cb_pdf.Items.Add(k)\r\ncb_pdf.SelectedIndex = 0\r\nform.Controls.Add(cb_pdf)\r\n\r\n# 5. Tiền tố & Tên file\r\nform.Controls.Add(create_label(\"4. Tiền tố file CAD:\", 20, 230, 620, 20))\r\ntxt_cad_prefix = TextBox()\r\ntxt_cad_prefix.Location = Point(20, 255)\r\ntxt_cad_prefix.Size = Size(620, 25)\r\ntxt_cad_prefix.Text = saved_cfg.get(\"cad_prefix\", \"DUAN\")\r\nform.Controls.Add(txt_cad_prefix)\r\n\r\nform.Controls.Add(create_label(\"5. Tên file PDF:\", 20, 295, 620, 20))\r\ntxt_pdf_name = TextBox()\r\ntxt_pdf_name.Location = Point(20, 320)\r\ntxt_pdf_name.Size = Size(620, 25)\r\ntxt_pdf_name.Text = saved_cfg.get(\"pdf_name\", \"TSG-WON\")\r\nform.Controls.Add(txt_pdf_name)\r\n\r\n# 6. Đường dẫn\r\nform.Controls.Add(create_label(\"6. Thư mục lưu file CAD:\", 20, 360, 620, 20))\r\ntxt_cad_path = TextBox()\r\ntxt_cad_path.Location = Point(20, 385)\r\ntxt_cad_path.Size = Size(620, 25)\r\ntxt_cad_path.Text = saved_cfg.get(\"cad_path\", \"C:\\\\ExportCAD\")\r\nform.Controls.Add(txt_cad_path)\r\n\r\nform.Controls.Add(create_label(\"7. Thư mục lưu file PDF:\", 20, 425, 620, 20))\r\ntxt_pdf_path = TextBox()\r\ntxt_pdf_path.Location = Point(20, 450)\r\ntxt_pdf_path.Size = Size(620, 25)\r\ntxt_pdf_path.Text = saved_cfg.get(\"pdf_path\", \"C:\\\\ExportPDF\")\r\nform.Controls.Add(txt_pdf_path)\r\n\r\n# Nút Run\r\nbtn_run = Button()\r\nbtn_run.Text = \"XUẤT BẢN VẼ (EXPORT)\"\r\nbtn_run.Location = Point(220, 520)\r\nbtn_run.Size = Size(220, 45)\r\nbtn_run.DialogResult = DialogResult.OK\r\nbtn_run.BackColor = Color.LightSkyBlue\r\nform.Controls.Add(btn_run)\r\n\r\n# Kiểm tra sau khi bấm Run\r\ndef is_step_successful():\r\n    return form.DialogResult == DialogResult.OK\r\n\r\n# Thực thi Export\r\nif form.ShowDialog() == DialogResult.OK:\r\n    target_name = cb_target.SelectedItem\r\n    cad_prefix = txt_cad_prefix.Text\r\n    pdf_name = txt_pdf_name.Text\r\n    cad_folder = txt_cad_path.Text\r\n    pdf_folder = txt_pdf_path.Text\r\n    \r\n    save_config(cad_prefix, pdf_name, cad_folder, pdf_folder, chk_cad.Checked, chk_pdf.Checked, chk_combine.Checked)\r\n\r\n    matched_sheets = []\r\n    if rb_col.Checked and target_name in col_dict:\r\n        target_col = col_dict[target_name]\r\n        for s in FilteredElementCollector(doc).OfClass(ViewSheet).ToElements():\r\n            p = s.get_Parameter(BuiltInParameter.SHEET_COLLECTION) or s.LookupParameter(\"Sheet Collection\")\r\n            if p and p.AsElementId() == target_col.Id:\r\n                matched_sheets.append(s)\r\n    elif target_name in set_dict:\r\n        for v in set_dict[target_name].Views:\r\n            if isinstance(v, ViewSheet): matched_sheets.append(v)\r\n\r\n    dwg_opt = dwg_setup_dict[cb_dwg.SelectedItem].GetDWGExportOptions() if cb_dwg.SelectedItem in dwg_setup_dict else DWGExportOptions()\r\n    dwg_opt.MergedViews = True\r\n\r\n    cad_cnt, pdf_cnt = 0, 0\r\n    TransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\n    if chk_cad.Checked and matched_sheets:\r\n        if not os.path.exists(cad_folder): os.makedirs(cad_folder)\r\n        for s in matched_sheets:\r\n            fn = \"{}-{}-{}\".format(cad_prefix, str(s.SheetNumber).replace(\"/\", \"-\"), str(s.Name).replace(\"/\", \"-\"))\r\n            if doc.Export(cad_folder, fn, System.Collections.Generic.List[ElementId]([s.Id]), dwg_opt):\r\n                cad_cnt += 1\r\n\r\n    if chk_pdf.Checked and matched_sheets:\r\n        if not os.path.exists(pdf_folder): os.makedirs(pdf_folder)\r\n        pdf_opt = pdf_setup_dict[cb_pdf.SelectedItem].GetPDFExportOptions() if cb_pdf.SelectedItem in pdf_setup_dict else PDFExportOptions()\r\n        pdf_opt.Combine = chk_combine.Checked\r\n        \r\n        if chk_combine.Checked:\r\n            pdf_opt.FileName = pdf_name\r\n            doc.Export(pdf_folder, System.Collections.Generic.List[ElementId]([s.Id for s in matched_sheets]), pdf_opt)\r\n            pdf_cnt = len(matched_sheets)\r\n        else:\r\n            for s in matched_sheets:\r\n                pdf_opt.FileName = \"{}-{}-{}\".format(pdf_name, str(s.SheetNumber).replace(\"/\", \"-\"), str(s.Name).replace(\"/\", \"-\"))\r\n                doc.Export(pdf_folder, System.Collections.Generic.List[ElementId]([s.Id]), pdf_opt)\r\n                pdf_cnt += 1\r\n\r\n    TransactionManager.Instance.TransactionTaskDone()\r\n    OUT = \"Thành công! Đã xuất {} file CAD và {} bản PDF.\".format(cad_cnt, pdf_cnt)\r\nelse:\r\n    OUT = \"Đã hủy.\"",
      "Engine": "CPython3",
